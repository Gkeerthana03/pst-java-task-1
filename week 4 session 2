'use strict';

const fs = require('fs');

const input = fs.readFileSync(0, 'utf8').trim().split(/\s+/);

let T = Number(input[0]);
let output = [];

for (let t = 1; t <= T; t++) {

    let s = input[t];
    let n = s.length;

    // Frequency arrays for left and right halves
    let left = new Array(26).fill(0);
    let right = new Array(26).fill(0);

    // Middle character is ignored automatically
    let half = Math.floor(n / 2);

    // Count left half
    for (let i = 0; i < half; i++) {
        left[s.charCodeAt(i) - 97]++;
    }

    // Count right half
    for (let i = Math.ceil(n / 2); i < n; i++) {
        right[s.charCodeAt(i) - 97]++;
    }

    // Compare frequencies
    let isLapindrome = true;

    for (let i = 0; i < 26; i++) {
        if (left[i] !== right[i]) {
            isLapindrome = false;
            break;
        }
    }

    output.push(isLapindrome ? "YES" : "NO");
}

console.log(output.join('\n'));
