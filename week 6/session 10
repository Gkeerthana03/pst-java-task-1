import java.io.*;
import java.util.*;

class Result {

    public static List<Integer> circularPalindromes(String s) {

        int n = s.length();

        // Duplicate the string so circular substrings become normal substrings.
        String doubled = s + s;

        int len = doubled.length();

        /*
         * Manacher's algorithm using transformed string:
         *
         * Example:
         * "aba" -> "#a#b#a#"
         *
         * radius[i] tells the palindrome radius around center i.
         */
        char[] t = new char[2 * len + 1];

        for (int i = 0; i < t.length; i++) {
            if (i % 2 == 0) {
                t[i] = '#';
            } else {
                t[i] = doubled.charAt(i / 2);
            }
        }

        int[] radius = new int[t.length];

        int center = 0;
        int right = 0;

        for (int i = 0; i < t.length; i++) {

            int mirror = 2 * center - i;

            if (i < right) {
                radius[i] = Math.min(right - i, radius[mirror]);
            }

            while (i + radius[i] + 1 < t.length &&
                   i - radius[i] - 1 >= 0 &&
                   t[i + radius[i] + 1] == t[i - radius[i] - 1]) {

                radius[i]++;
            }

            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }

        int[] answer = new int[n];

        /*
         * Initially every rotation contains at least
         * one character, so answer = 1.
         */
        Arrays.fill(answer, 1);

        /*
         * For each possible center, determine the longest
         * palindrome that can fit inside a window of length n.
         *
         * We use the duplicated string, and only consider
         * palindromes that can occur inside a circular rotation.
         */
        for (int c = 0; c < t.length; c++) {

            int r = radius[c];

            if (r == 0) {
                continue;
            }

            // Convert transformed-string radius to character length.
            int maxLength = r;

            // A rotation has at most n characters.
            maxLength = Math.min(maxLength, n);

            /*
             * Center in the original doubled string.
             */
            double centerPos = c / 2.0;

            /*
             * Try the rotations affected by this palindrome.
             *
             * We only need centers in the useful range [0, 2n).
             */
            int centerIndex = c / 2;

            for (int start = Math.max(0, centerIndex - n);
                 start < Math.min(n, centerIndex + 1);
                 start++) {

                int left = start;
                int rightBound = start + n - 1;

                /*
                 * Maximum palindrome around this center
                 * that fits inside [left, rightBound].
                 */
                int availableLeft = (int) Math.floor(centerPos - left);
                int availableRight = (int) Math.floor(rightBound - centerPos);

                int possible = Math.min(r, Math.min(
                        availableLeft + (c % 2),
                        availableRight + 1
                ));

                possible = Math.min(possible, n);

                if (possible > answer[start]) {
                    answer[start] = possible;
                }
            }
        }

        List<Integer> result = new ArrayList<>();

        for (int value : answer) {
            result.add(value);
        }

        return result;
    }
}

public class Solution {

    public static void main(String[] args) throws Exception {

        BufferedReader br = new BufferedReader(
                new InputStreamReader(System.in)
        );

        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();

        List<Integer> result = Result.circularPalindromes(s);

        StringBuilder output = new StringBuilder();

        for (int value : result) {
            output.append(value).append('\n');
        }

        System.out.print(output);
    }
}
