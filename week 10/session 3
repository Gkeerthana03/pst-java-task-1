Question: 3 - Browser History — Linear Collection

A web browser stores recently visited pages. When the user presses the Back button, the most recently visited page should be removed first.

give the java code corret;ly

import java.util.Scanner;
import java.util.Stack;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Stack<String> history = new Stack<>();

        int n = sc.nextInt();
        sc.nextLine();

        // Store visited pages
        for (int i = 0; i < n; i++) {
            String page = sc.nextLine();
            history.push(page);
        }

        int back = sc.nextInt();

        // Press Back button
        for (int i = 0; i < back; i++) {
            if (!history.empty()) {
                history.pop();
            }
        }

        // Display current browser history
        if (history.empty()) {
            System.out.println("No pages in history");
        } else {
            System.out.println("Current Page: " + history.peek());

            System.out.println("Browser History:");
            for (String page : history) {
                System.out.println(page);
            }
        }

        sc.close();
    }
}
