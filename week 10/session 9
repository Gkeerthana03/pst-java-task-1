Question: 9 - Student Marks Using HashMap

Scenario: 

A teacher wants to store the marks of students using their roll numbers as keys. Write a Java program to display the marks of a particular student.
java code correctly


import java.util.HashMap;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        HashMap<Integer, Integer> marks = new HashMap<>();

        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {
            int rollNo = sc.nextInt();
            int mark = sc.nextInt();
            marks.put(rollNo, mark);
        }

        int searchRollNo = sc.nextInt();

        if (marks.containsKey(searchRollNo)) {
            System.out.println(marks.get(searchRollNo));
        } else {
            System.out.println("Student not found");
        }

        sc.close();
    }
}
